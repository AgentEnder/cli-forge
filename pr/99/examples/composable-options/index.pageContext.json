,</span></span>\n<span class=\"line\"><span style=\"color:#C4A882\">    default</span><span style=\"color:#A08060\">:</span><span style=\"color:#A08060\"> '</span><span style=\"color:#FFB347\">Goodbye</span><span style=\"color:#A08060\">'</span><span style=\"color:#A08060\">,</span></span>\n<span class=\"line\"><span style=\"color:#A08060\">  })</span></span>\n<span class=\"line\"><span style=\"color:#A08060\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A5040;font-style:italic\">// -- Commands with return values --</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#FF8C38\">const</span><span style=\"color:#FF6A35\"> withGreetCommand</span><span style=\"color:#A08060\"> =</span><span style=\"color:#E8C090\"> </span><a href=\"/cli-forge/pr/99/api/cli-forge/make-composable-builder\" class=\"typedoc-link\"><span style=\"color:#E8C090\">makeComposableBuilder</span></a><span style=\"color:#A08060\">((</span><span style=\"color:#D4B898\">args</span><span style=\"color:#A08060\">)</span><span style=\"color:#FF8C38\"> =></span></span>\n<span class=\"line\"><span style=\"color:#C4A882\">  args</span><span style=\"color:#A08060\">.</span><span style=\"color:#E8C090\">command</span><span style=\"color:#A08060\">(</span><span style=\"color:#A08060\">'</span><span style=\"color:#FFB347\">greet</span><span style=\"color:#A08060\">'</span><span style=\"color:#A08060\">,</span><span style=\"color:#A08060\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E8C090\">    builder</span><span style=\"color:#A08060\">:</span><span style=\"color:#A08060\"> (</span><span style=\"color:#D4B898\">args</span><span style=\"color:#A08060\">)</span><span style=\"color:#FF8C38\"> =></span><span style=\"color:#E8C090\"> </span><a href=\"/cli-forge/pr/99/api/parser/chain\" class=\"typedoc-link\"><span style=\"color:#E8C090\">chain</span></a><span style=\"color:#A08060\">(</span><span style=\"color:#C4A882\">