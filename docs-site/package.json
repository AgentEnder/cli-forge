{
  "name": "@cli-forge/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build && pnpm exec pagefind --site dist/client",
    "preview": "vike build && pnpm exec pagefind --site dist/client && vike preview",
    "typecheck": "tsc",
    "extract-cli-docs": "pnpm cli-forge generate-documentation ../packages/cli-forge/src/bin/cli.ts --output ./docs/cli"
  },
  "dependencies": {
    "@functional-examples/documentation": "^0.1.1",
    "@icons-pack/react-simple-icons": "^13.11.2",
    "@shikijs/rehype": "^3.21.0",
    "cli-forge": "workspace:",
    "functional-examples": "^0.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-github-alerts": "^4.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "rehype-typedoc": "^0.1.0",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.21.0",
    "unified": "^11.0.5",
    "vike": "^0.4.252",
    "vike-plugin-typedoc": "^0.1.0",
    "vike-react": "^0.6.19",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  },
  "nx": {
    "name": "docs-site",
    "implicitDependencies": [
      "cli-forge",
      "parser"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "extract-cli-docs"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "deploy": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx-github-pages:deploy",
        "options": {
          "remote": "https://github.com/agentender/cli-forge.git",
          "directory": "{projectRoot}/dist/client"
        }
      },
      "extract-cli-docs": {
        "dependsOn": [
          {
            "target": "build",
            "projects": "cli-forge"
          }
        ]
      },
      "serve": {
        "command": "vike dev",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "extract-cli-docs"
        ]
      }
    }
  }
}
