{
  "name": "@cli-forge/docs-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "serve": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "catalog:",
    "@docusaurus/preset-classic": "catalog:",
    "@mdx-js/react": "catalog:",
    "clsx": "catalog:",
    "prism-react-renderer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hot-toast": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "catalog:",
    "@docusaurus/tsconfig": "catalog:",
    "@docusaurus/types": "catalog:",
    "@docusaurus/theme-common": "catalog:",
    "docusaurus-plugin-typedoc": "catalog:",
    "@docusaurus/remark-plugin-npm2yarn": "catalog:",
    "@typescript/sandbox": "catalog:",
    "docusaurus-plugin-sass": "catalog:",
    "fast-glob": "catalog:",
    "monaco-editor": "catalog:",
    "monaco-editor-webpack-plugin": "catalog:",
    "sass": "catalog:",
    "remark-github": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "style-loader": "catalog:",
    "@nx/devkit": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "nx": {
    "name": "docs-site",
    "implicitDependencies": [
      "cli-forge",
      "parser"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "extract-cli-docs"
        ],
        "outputs": [
          "{projectRoot}/.docusaurus",
          "{projectRoot}/build",
          "{projectRoot}/docs/examples",
          "{projectRoot}/docs/api"
        ],
        "inputs": [
          "{projectRoot}/**/*",
          "{projectRoot}/docusaurus.config.js",
          "!{projectRoot}/src/**/*.d.ts",
          "!{projectRoot}/docs/examples",
          "!{projectRoot}/docs/api"
        ]
      },
      "deploy": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx-github-pages:deploy",
        "options": {
          "remote": "https://github.com/agentender/cli-forge.git",
          "directory": "{projectRoot}/build"
        }
      },
      "extract-cli-docs": {
        "dependsOn": [
          {
            "target": "build",
            "projects": "cli-forge"
          }
        ],
        "command": "npx tsx ./tools/scripts/extract-cli-docs.ts"
      },
      "serve": {
        "dependsOn": [
          "extract-cli-docs"
        ]
      },
      "serve-static": {
        "command": "npx docusaurus serve",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
