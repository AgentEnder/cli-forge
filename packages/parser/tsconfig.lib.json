{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "types": ["node"],
    "tsBuildInfoFile": "tsconfig.lib.json.tsbuildinfo",
    "noImplicitAny": true,
    "importHelpers": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["vite.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/type-debug.ts"]
}
