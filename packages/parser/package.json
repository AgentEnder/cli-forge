{
  "name": "@cli-forge/parser",
  "version": "1.7.2",
  "scripts": {
    "build:tsdown": "tsdown"
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "typings": "./dist/index.d.mts",
  "license": "ISC",
  "homepage": "https://craigory.dev/cli-forge/",
  "repository": {
    "type": "git",
    "directory": "packages/parser",
    "url": "https://github.com/AgentEnder/cli-forge"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "**/*.md"
  ],
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "pnpm run build:tsdown"
          ],
          "parallel": false
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
