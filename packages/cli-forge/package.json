{
  "name": "cli-forge",
  "version": "0.0.1",
  "dependencies": {
    "tslib": "catalog:",
    "@cli-forge/parser": "workspace:*"
  },
  "peerDependencies": {
    "markdown-factory": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "markdown-factory": {
      "optional": true,
      "dev": true
    },
    "tsx": {
      "optional": true,
      "dev": true
    },
    "zod": {
      "optional": true
    }
  },
  "type": "commonjs",
  "main": "./src/index.js",
  "typings": "./src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "directory": "packages/cli-forge",
    "url": "https://github.com/AgentEnder/cli-forge"
  },
  "bin": {
    "cli-forge": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./middleware": {
      "require": "./src/middleware.js",
      "types": "./src/middleware.d.ts"
    },
    "./middleware/*": {
      "require": "./src/middleware/*.js",
      "types": "./src/middleware/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
