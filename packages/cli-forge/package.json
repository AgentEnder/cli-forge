{
  "name": "cli-forge",
  "version": "1.7.1",
  "dependencies": {
    "tslib": "catalog:",
    "@cli-forge/parser": "workspace:*"
  },
  "peerDependencies": {
    "@clack/prompts": "*",
    "markdown-factory": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@clack/prompts": {
      "optional": true
    },
    "markdown-factory": {
      "optional": true,
      "dev": true
    },
    "tsx": {
      "optional": true,
      "dev": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "catalog:"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "license": "ISC",
  "homepage": "https://craigory.dev/cli-forge/",
  "repository": {
    "type": "git",
    "directory": "packages/cli-forge",
    "url": "https://github.com/AgentEnder/cli-forge"
  },
  "bin": {
    "cli-forge": "./cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "require": "./dist/bin/cli.js",
      "types": "./dist/bin/cli.d.ts"
    },
    "./middleware": {
      "require": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    },
    "./middleware/*": {
      "require": "./dist/middleware/*.js",
      "types": "./dist/middleware/*.d.ts"
    },
    "./prompt-providers/clack": {
      "require": "./dist/prompt-providers/clack.js",
      "types": "./dist/prompt-providers/clack.d.ts",
      "import": "./dist/prompt-providers/clack.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
