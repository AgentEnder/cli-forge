{
  "name": "e2e",
  "implicitDependencies": ["examples", "parser", "cli-forge"],
  "targets": {
    "e2e": {
      "dependsOn": [
        {
          "target": "e2e:*",
          "projects": "self"
        }
      ]
    },
    "e2e:jest": {
      "command": "jest --config {projectRoot}/jest.config.ts"
    },
    "e2e:examples": {
      "command": "tsx {projectRoot}/run-examples.ts",
      "dependsOn": ["^build"]
    }
  },
  "metadata": {
    "targetGroups": {
      "E2E": ["e2e", "e2e:jest", "e2e:examples"]
    }
  }
}
